{
  "name": "pdf-viewer-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/check-extension.mjs",
    "test": "node scripts/test-suites.mjs all",
    "test:feature": "node scripts/test-suites.mjs",
    "test:document": "node scripts/test-suites.mjs document",
    "test:appearance": "node scripts/test-suites.mjs appearance",
    "test:selection": "node scripts/test-suites.mjs selection",
    "test:enhance": "node --test tests/enhance-failure.test.mjs tests/enhance-pdf.test.mjs tests/enhancer-setup.test.mjs",
    "test:footnotes": "node scripts/test-suites.mjs footnotes",
    "test:image-gallery": "node --test tests/image-gallery.test.mjs",
    "check:suites": "node scripts/test-suites.mjs --list",
    "check:syntax": "node scripts/check-javascript.mjs",
    "test:paragraph-double-click": "node --test tests/paragraph-double-click.test.mjs",
    "test:recovery": "node --test tests/pdf-tab-recovery.test.mjs"
  },
  "dependencies": {
    "pdfjs-dist": "6.3.289",
    "qr": "0.7.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
